# notify.sh config — copy to .notify.env and fill in. NEVER commit .notify.env:
# the webhook URL embeds a secret token, and .gitignore excludes it for that reason.
#
#   cp System_Config/.notify.env.example System_Config/.notify.env
#   chmod 600 System_Config/.notify.env
#
# `cp` prints nothing on success — that silence IS success. The file is hidden
# (leading dot), so confirm with: ls -la System_Config/.notify.env

# ── Delivery ──────────────────────────────────────────────────────────────────
# Create the webhook: open the target Google Chat space -> expand-more arrow next to
# the space title -> Apps & integrations -> Add webhooks -> give it a name and an
# optional avatar URL -> Save -> copy the URL from the More menu.
#
# The form does NOT ask for a URL pointing at this machine. Google GENERATES the URL
# below and hands it to you; nothing ever connects inbound to your Mac.
#
# Requires the Workspace admin setting "let users add and use incoming webhooks".
# If "Add webhooks" is greyed out, your org has it disabled — leave this empty and
# set GCHAT_FALLBACK_LOCAL=1 for macOS banners instead.
GCHAT_WEBHOOK_URL=""

# Also raise a local macOS notification (1 = yes). Used automatically as a fallback
# whenever the Chat POST fails, regardless of this setting.
GCHAT_FALLBACK_LOCAL=0

# Message style: card (rich, default) or text (plain). A card that Chat rejects
# automatically retries as text, so `card` is safe to leave on.
GCHAT_STYLE=card

# ── What may be said out loud ─────────────────────────────────────────────────
# Some events inherently carry vault content: new wiki page names, decision text,
# clip filenames, Rally story titles. They are SUPPRESSED unless this is 1, so a
# corporate Chat space never receives note content by accident. Counts and check
# names are always sent regardless.
GCHAT_INCLUDE_CONTENT=0

# One Chat message per ingested clip. Noisy — off unless you want a running feed.
GCHAT_VERBOSE=0

# ── Spend ─────────────────────────────────────────────────────────────────────
# Alert once per day when the day's API spend crosses this figure (USD).
# Context: a single headless call from this workspace costs ~$0.124 before doing any
# work (~50k tokens of fixed context load first), so a busy run of four tasks has a
# floor near $0.50. Inspect anytime with: bash System_Config/spend.sh report
SPEND_ALERT_USD=10

# ── Buttons ───────────────────────────────────────────────────────────────────
# If the status dashboard is reachable over http(s), put its URL here and health
# messages gain an "Open dashboard" button. A local file:// path cannot be a Chat
# button (Chat only accepts http/https), so leave this empty if the page is local.
STATUS_PAGE_URL=""

# ── Rally ─────────────────────────────────────────────────────────────────────
# Project alias/name for rally_notify.sh. REQUIRED for any Rally event — there is no
# safe default, since `rally project list` returns hundreds and guessing would report
# on the wrong team's board. Find yours with:
#   rally project list | grep -i <your team>
RALLY_PROJECT=""

# Warn when the current iteration has this many days left or fewer.
RALLY_ITERATION_WARN_DAYS=3
