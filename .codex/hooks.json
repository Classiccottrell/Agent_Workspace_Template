{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null) && python3 \"$root/.codex/hooks/readme-currency-check.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
